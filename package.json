{
  "name": "@dexvis/root-geo-tree-editor",
  "version": "0.1.1",
  "description": "Utility functions for navigating and manipulating TGeo nodes within the CERN ROOT framework. Includes functionalities to walk through geometric nodes with customizable callbacks, find nodes matching specific patterns, and analyze nodes based on provided criteria.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dexvis/root-geo-tree-editor.git"
  },
  "keywords": [
    "root",
    "geometry",
    "cern",
    "tgeo",
    "tree",
    "editor"
  ],
  "author": "dexvis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dexvis/root-geo-tree-editor/issues"
  },
  "homepage": "https://github.com/dexvis/root-geo-tree-editor#readme",
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
